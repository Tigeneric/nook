    "Nook lives in the menu bar and answers a hotkey; without this it has to be started by hand after every restart." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook живёт в меню-баре и отвечает на хоткей; без этого его придётся запускать руками после каждой перезагрузки."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook живи у мени траци и одазива се на пречицу; без овога треба га ручно покретати после сваког рестарта."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook živi u meni traci i odaziva se na prečicu; bez ovoga treba ga ručno pokretati posle svakog restarta."
          }
        }
      }
    },
